PORT=5000
NODE_ENV=development

# Local MongoDB or a free MongoDB Atlas cluster
MONGODB_URI=mongodb://127.0.0.1:27017/queue-mitra

# Use a long random string, e.g. node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Frontend origin allowed by CORS and Socket.io
CLIENT_URL=http://localhost:5173

HOSPITAL_TIMEZONE=Asia/Kolkata

# Free LLM Voice Translation & Triage via OpenRouter (Get free key at openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
