PORT=5001
NODE_ENV=development

# MongoDB. Production: a MongoDB Atlas connection string (required).
# Development: if nothing runs at this localhost address, a local database is started automatically
# and stored in backend/.data/db (survives restarts; wipe it with: npm run reset-db -- --yes).
MONGODB_URI=mongodb://127.0.0.1:27017/queue-mitra

# Long random string (production: at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Browser origin(s) allowed by CORS and Socket.io, comma-separated (dev also allows any localhost port)
CLIENT_URL=http://localhost:5180
# Base URL printed in the slip QR code (defaults to the first CLIENT_URL)
# PUBLIC_APP_URL=https://queue-mitra.example.org

HOSPITAL_TIMEZONE=Asia/Kolkata

# Production hosting (defaults shown)
# TRUST_PROXY=1
# SERVE_FRONTEND=true        # serve ../frontend/dist from this server (default on in production)
# FRONTEND_DIST=../frontend/dist
# CSP=on

# Optional: free LLM voice translation & triage via OpenRouter (rule-based fallback without a key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
