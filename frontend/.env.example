# Where the dev/preview server proxies /api and /socket.io (the backend's address).
# macOS uses port 5000 for AirPlay Receiver, so set PORT=5001 in backend/.env and use that here.
VITE_API_PROXY=http://localhost:5000

# Optional: call the backend directly instead of through the proxy (needs CORS + CLIENT_URL on the backend).
# VITE_API_URL=https://your-backend.example.com

# Optional: hospital whose queues, departments and board this app shows.
# VITE_HOSPITAL_CODE=CDH
